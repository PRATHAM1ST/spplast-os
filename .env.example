# Server-only runtime connection: use a login granted spplast_app, not the schema owner.
DATABASE_URL=
# Migration owner connection; never used for app requests.
DATABASE_ADMIN_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
APP_URL=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=
# Private Neon Object Storage or S3-compatible provider.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=spplast-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Demo uses a separate IndexedDB database, never production records.
NEXT_PUBLIC_ENABLE_DEMO=true
